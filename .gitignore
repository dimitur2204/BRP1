# Python virtual environment (~5.5GB) -- regenerate with:
#   python3 -m venv env/.venv && env/.venv/bin/pip install numpy==1.26.4 nibabel \
#     matplotlib pandas scipy torch scikit-learn lifelines scikit-survival
env/

# Public NLST IDC-780 clinical package (TCIA, CC BY 4.0): outcome + age/sex/smoking.
# Regeneration command: docs/pipeline.md, section 6.
data/external/

# S2 lung-volume cache (~39 GB uint8 memmap + per-task chunks) -- regenerate with:
#   sbatch src/submit_s2_preprocess.sh && env/.venv/bin/python src/s2_preprocess.py --merge
data/cache/

# S4 training runs (config/history/pred/model/curves) -- regenerate with:
#   sbatch src/submit_s4_train.sh
runs/
models/*.pt

# Slurm job logs
logs/*.out
logs/*.err

# Python
__pycache__/
*.pyc

# Editor swap/undo files
*.swp
*.swo
*.un~
