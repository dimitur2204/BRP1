# Python virtual environment (~5.5GB) -- regenerate with:
#   python3 -m venv env/.venv && env/.venv/bin/pip install numpy nibabel matplotlib \
#     pandas scipy torch scikit-learn lifelines
# (CUDA torch build for the sbatch jobs: `pip install torch`, no --index-url;
# see PROGRESS.md for the CPU-vs-CUDA build history.)
env/

# Cached per-organ crops (~14GB) -- regenerate with src/cache_organ_crops.py
# (reads data/pid_lists/subset_v1.csv, which IS tracked).
data/organ_crops/

# Trained 3D CNN checkpoints -- regenerate via src/submit_stage3_cnn3d.sh
models/*.pt

# Slurm job logs -- ephemeral, recreated per job submission
logs/*.out
logs/*.err

# Python
__pycache__/
*.pyc

# Editor swap/undo files
*.swp
*.swo
*.un~

# Grad-CAM volumes (~254MB .nii.gz) -- regenerate via src/submit_stage6_saliency.sh
data/saliency/

# Public NLST IDC-780 clinical package (TCIA, CC BY 4.0) -- regenerate with:
#   mkdir -p data/external/nlst_780 && cd data/external/nlst_780 && curl -sSLO \
#     https://www.cancerimagingarchive.net/wp-content/uploads/package-nlst-780.2021-05-28.zip \
#     && unzip -q package-nlst-780.2021-05-28.zip && cd nlst_780 \
#     && unzip -q nlst780.idc.delivery.052821.zip && for z in *.csv.zip; do unzip -q "$z"; done
data/external/

# R2 per-array-task chunk CSVs -- merged into data/radiomics/{organ}_features_v1.csv
# by `src/r2_extract_radiomics.py --merge`
data/radiomics/*_chunks/

# R2/R3 per-patient feature tables (~13-14MB each) -- regenerate with:
#   sbatch src/submit_r2_radiomics.sh && env/.venv/bin/python src/r2_extract_radiomics.py --merge
#   env/.venv/bin/python src/r3_feature_qc.py
data/radiomics/heart_features_v1.csv
data/radiomics/heart_features_v1_r3.csv
